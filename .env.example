
DATABASE_URL= your neon connection with pooler
DIRECT_URL= your neon connection without pooler


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QSTASH_CURRENT_SIGNING_KEY= (terpakai: verifikasi signature cron QStash)
QSTASH_NEXT_SIGNING_KEY= (terpakai: verifikasi signature, cadangan rotasi key)
US_EAST_1_QSTASH_URL= (terpakai: base URL script setup jadwal)
US_EAST_1_QSTASH_TOKEN= (terpakai: token script setup jadwal)

VAPID_PUBLIC_KEY= (terpakai: kirim push dari server)
NEXT_PUBLIC_VAPID_PUBLIC_KEY= (terpakai: subscribe push di browser, sama dgn vapid public key)
VAPID_PRIVATE_KEY= (terpakai: tanda tangan push server)
VAPID_SUBJECT=https://chatme-jet.vercel.app (terpakai: identitas VAPID)

CRON_SECRET= (terpakai: trigger manual GET cron)
REMINDER_REPEAT_MINUTES=10 (opsional: interval notif ulang pengingat, default 10)

NOTE_ENCRYPTION_KEY= (jalankan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")